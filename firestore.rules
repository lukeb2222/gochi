rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function member() { return signed() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned == false; }
  function admin() { return member() && request.auth.token.email == 'lukebalyasny.11@gmail.com' && request.auth.token.email_verified == true; }
  function reactionOne(emoji) {
   let changed = request.resource.data.reactions.diff(resource.data.reactions).affectedKeys();
   let before = resource.data.reactions.get(emoji, []);
   let after = request.resource.data.reactions.get(emoji, []);
   return changed.size() == 1 && changed.hasOnly([emoji]) && after is list && after.size() <= 100 && (
     (after.hasAll(before) && after.size() == before.size() + 1 && request.auth.uid in after && !(request.auth.uid in before)) ||
     (before.hasAll(after) && before.size() == after.size() + 1 && request.auth.uid in before && !(request.auth.uid in after))
   );
  }
  function reactionChange() { return reactionOne('😀') || reactionOne('😂') || reactionOne('😍') || reactionOne('❤️') || reactionOne('🔥') || reactionOne('👍') || reactionOne('🎉') || reactionOne('👀'); }
  match /invites/{code} { allow read, write: if false; }
  match /users/{id} {
   allow get: if signed() && (request.auth.uid == id || member());
   allow list: if member();
   allow create: if signed() && request.auth.uid == id && ((request.auth.token.email == 'lukebalyasny.11@gmail.com' && request.auth.token.email_verified == true) || (request.resource.data.inviteCode is string && request.resource.data.inviteCode.size() >= 24 && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)) && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.email == request.auth.token.email && request.auth.token.email_verified == true)) && request.resource.data.credits == 30 && request.resource.data.points == 0 && request.resource.data.role == (request.auth.token.email == 'lukebalyasny.11@gmail.com' ? 'admin' : 'member') && request.resource.data.banned == false && request.resource.data.inventory.size() == 0 && request.resource.data.friends.size() == 0 && request.resource.data.pending.size() == 0 && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 30 && request.resource.data.avatar is map && request.resource.data.avatar.keys().hasOnly(['skin','hair','hat','outfit','accessory','background','badge','photo']) && request.resource.data.avatar.get('photo','').size() <= 200000 && request.resource.data.keys().hasOnly(['name','avatar','credits','points','inventory','friends','pending','role','banned','inviteCode','createdAt']);
   allow update: if member() && (
     (request.auth.uid == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','avatar']) && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 30 && request.resource.data.avatar is map && request.resource.data.avatar.keys().hasOnly(['skin','hair','hat','outfit','accessory','background','badge','photo']) && request.resource.data.avatar.get('photo','').size() <= 200000) ||
     (request.auth.uid != id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pending']) && request.resource.data.pending.hasAll(resource.data.pending) && request.resource.data.pending.size() == resource.data.pending.size() + 1 && request.auth.uid in request.resource.data.pending && !(request.auth.uid in resource.data.pending)) ||
     (request.auth.uid == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends','pending']) && request.resource.data.friends.hasAll(resource.data.friends) && request.resource.data.friends.size() == resource.data.friends.size() + 1 && resource.data.pending.hasAll(request.resource.data.pending) && resource.data.pending.size() == request.resource.data.pending.size() + 1 && resource.data.pending.hasAny(request.resource.data.friends.removeAll(resource.data.friends)) && resource.data.pending.removeAll(request.resource.data.pending) == request.resource.data.friends.removeAll(resource.data.friends)) ||
     (request.auth.uid != id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) && request.resource.data.friends.hasAll(resource.data.friends) && request.resource.data.friends.size() == resource.data.friends.size() + 1 && request.auth.uid in request.resource.data.friends && !(request.auth.uid in resource.data.friends) && id in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friends)
   );
  }
  match /rooms/{id} {
   allow get: if member() && (resource.data.type == 'public' || request.auth.uid in resource.data.members);
   allow list: if member() && (resource.data.type == 'public' || request.auth.uid in resource.data.members);
   allow create: if admin() || member() && request.resource.data.type == 'dm' && request.auth.uid in request.resource.data.members && request.resource.data.members.size() == 2 && request.resource.data.members[0] != request.resource.data.members[1] && request.resource.data.createdBy == request.auth.uid && exists(/databases/$(database)/documents/users/$(request.resource.data.members[0])) && exists(/databases/$(database)/documents/users/$(request.resource.data.members[1])) && request.resource.data.members[1] in get(/databases/$(database)/documents/users/$(request.resource.data.members[0])).data.friends && request.resource.data.members[0] in get(/databases/$(database)/documents/users/$(request.resource.data.members[1])).data.friends;
   allow update: if admin(); // private joins must use a trusted backend after validating the code
   match /messages/{mid} {
    allow read: if member() && (get(/databases/$(database)/documents/rooms/$(id)).data.type == 'public' || request.auth.uid in get(/databases/$(database)/documents/rooms/$(id)).data.members);
    allow create: if member() && (get(/databases/$(database)/documents/rooms/$(id)).data.type == 'public' || request.auth.uid in get(/databases/$(database)/documents/rooms/$(id)).data.members) && request.resource.data.uid == request.auth.uid && request.resource.data.name == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name && request.resource.data.flagged is bool && request.resource.data.reactions == {} && request.resource.data.kind in ['text','image','audio'] && (request.resource.data.kind == 'text' && request.resource.data.text.size() <= 1600 || request.resource.data.kind in ['image','audio'] && request.resource.data.media.size() <= 520000);
    allow update: if (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flagged'])) || (member() && (get(/databases/$(database)/documents/rooms/$(id)).data.type == 'public' || request.auth.uid in get(/databases/$(database)/documents/rooms/$(id)).data.members) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) && reactionChange());
   }
  }
  match /events/{id} { allow read: if member(); allow create: if admin(); }
 }
}
